## Result Pattern (Alternative to Exceptions)

For cases where errors are expected flow, use the Result pattern.

```python
# src/domain/result.py
from dataclasses import dataclass
from typing import Generic, TypeVar

T = TypeVar("T")
E = TypeVar("E")

@dataclass(frozen=True)
class Success(Generic[T]):
    """Successful result containing a value."""
    value: T

@dataclass(frozen=True)
class Failure(Generic[E]):
    """Failed result containing an error."""
    error: E

Result = Success[T] | Failure[E]

# Helper functions
def success(value: T) -> Success[T]:
    return Success(value)

def failure(error: E) -> Failure[E]:
    return Failure(error)
```

### Usage Example

```python
# src/application/usecases/create_user.py
from src.domain.result import Result, success, failure

class CreateUserUseCase:
    def execute(self, email: str) -> Result[User, str]:
        # Check if user exists
        existing = self._user_repo.find_by_email(email)
        if existing:
            return failure("User with this email already exists")
        
        # Create user
        user = User(id=uuid4(), email=email)
        saved = self._user_repo.save(user)
        return success(saved)

# In endpoint
@router.post("/users")
async def create_user(request: CreateUserRequest) -> UserResponse:
    result = usecase.execute(request.email)
    
    match result:
        case Success(user):
            return UserResponse.from_entity(user)
        case Failure(error):
            raise HTTPException(status_code=400, detail=error)
```

## Best Practices

### Do's

```python
# ✅ Use specific exception types
raise EntityNotFoundError("User", user_id)

# ✅ Include context in exceptions
raise ValidationError(field="email", message="Invalid format")

# ✅ Catch specific exceptions
try:
    user = repo.get(user_id)
except EntityNotFoundError:
    return None

# ✅ Re-raise with context
try:
    external_api.call()
except requests.RequestException as e:
    raise ExternalServiceError("PaymentAPI", str(e)) from e
```

### Don'ts

```python
# ❌ Don't use bare except
try:
    do_something()
except:  # Bad!
    pass

# ❌ Don't catch Exception broadly
try:
    do_something()
except Exception:  # Too broad
    pass

# ❌ Don't lose exception context
try:
    external_api.call()
except requests.RequestException:
    raise ExternalServiceError("API failed")  # Lost original exception!

# ❌ Don't use exceptions for flow control
try:
    user = repo.get(user_id)
except EntityNotFoundError:
    user = create_default_user()  # Use if/else instead
```

## HTTP Status Code Mapping

| Exception Type | HTTP Status | When to Use |
|----------------|-------------|-------------|
| `ValidationError` | 400 | Invalid request data |
| `UnauthorizedError` | 401 | Missing/invalid authentication |
| `ForbiddenError` | 403 | Authenticated but not permitted |
| `EntityNotFoundError` | 404 | Resource doesn't exist |
| `ConflictError` | 409 | State conflict (e.g., duplicate) |
| `ExternalServiceError` | 502 | Upstream service failure |
| Unhandled exceptions | 500 | Unexpected server errors |

## Testing Exceptions

```python
# tests/unit/domain/test_exceptions.py
import pytest
from src.domain.exceptions import EntityNotFoundError, ValidationError

class TestEntityNotFoundError:
    def test_message_format(self) -> None:
        exc = EntityNotFoundError("User", "123")
        assert exc.message == "User with id '123' not found"
        assert exc.details == {"entity_type": "User", "entity_id": "123"}

class TestValidationError:
    def test_message_format(self) -> None:
        exc = ValidationError("email", "Invalid format")
        assert "email" in exc.message
        assert exc.details["field"] == "email"
```

```python
# tests/e2e/test_error_responses.py
def test_not_found_returns_404(client: TestClient) -> None:
    response = client.get("/users/nonexistent-id")
    
    assert response.status_code == 404
    assert response.json()["error"] == "not_found"

def test_validation_error_returns_400(client: TestClient) -> None:
    response = client.post("/users", json={"email": "invalid"})
    
    assert response.status_code == 400
    assert response.json()["error"] == "validation_error"
```
